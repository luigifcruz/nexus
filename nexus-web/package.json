{
    "name": "nexus-web",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "clean:proto": "rm -rf ./src/lib/proto",
        "generate:proto": "yarn clean:proto && mkdir -p ./src/lib/proto && npx protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=./src/lib/proto --es_opt=target=ts,import_extension=ts,ts_nocheck=false -I ../nexus-common/proto ../nexus-common/proto/*.proto",
        "dev": "yarn generate:proto && vite dev",
        "build": "yarn generate:proto && vite build",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
    },
    "devDependencies": {
        "@dnd-kit-svelte/core": "^0.0.8",
        "@dnd-kit-svelte/modifiers": "^0.0.8",
        "@dnd-kit-svelte/sortable": "^0.0.8",
        "@dnd-kit-svelte/utilities": "^0.0.8",
        "@internationalized/date": "^3.8.1",
        "@lucide/svelte": "^0.515.0",
        "@sveltejs/adapter-auto": "^6.0.0",
        "@sveltejs/kit": "^2.22.0",
        "@sveltejs/vite-plugin-svelte": "^6.0.0",
        "@tabler/icons-svelte": "^3.31.0",
        "@tailwindcss/typography": "^0.5.15",
        "@tailwindcss/vite": "^4.0.0",
        "@tanstack/table-core": "^8.20.5",
        "@types/d3-scale": "^4.0.8",
        "@types/d3-shape": "^3.1.7",
        "bits-ui": "^2.8.6",
        "clsx": "^2.1.1",
        "d3-scale": "^4.0.2",
        "d3-shape": "^3.2.0",
        "layerchart": "^2.0.0-next.27",
        "svelte": "^5.0.0",
        "svelte-check": "^4.0.0",
        "svelte-sonner": "^1.0.5",
        "tailwind-merge": "^3.3.1",
        "tailwind-variants": "^1.0.0",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.3.6",
        "typescript": "^5.0.0",
        "vaul-svelte": "^1.0.0-next.7",
        "vite": "^7.0.4",
        "zod": "^3.25.64"
    },
    "dependencies": {
        "@bufbuild/protoc-gen-es": "^2.9.0",
        "@bufbuild/protobuf": "^2.9.0",
        "@connectrpc/connect": "^2.1.0",
        "@connectrpc/connect-web": "^2.1.0",
        "@xyflow/svelte": "^1.2.4"
    }
}
